ledger: ".muckpile/ — dos refs por vista" {
  provider: "refs/remotes/provider/to-work/ACC-1\nlo que dijo el proveedor\nsólo avanza, sólo lo mueve muckpile" {shape: queue}
  view: "to-work/ACC-1\nlo del proveedor, y lo propio encima\nsu upstream es la ref del proveedor" {shape: queue}
